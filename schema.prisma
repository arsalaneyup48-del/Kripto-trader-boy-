generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/crypto_trading_bot/nodejs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model chat_message {
  id        Int      @id @default(autoincrement())
  user_id   String
  message   String
  role      String   // user | assistant
  created_at DateTime @default(now())

  @@index([user_id, created_at])
}

model user_instruction {
  id          Int      @id @default(autoincrement())
  user_id     String
  instruction String
  active      Boolean  @default(true)
  created_at  DateTime @default(now())

  @@index([user_id])
}

model sent_alert {
  id         Int      @id @default(autoincrement())
  parity     String
  direction  String
  confidence Int      @default(0)
  sent_at    DateTime @default(now())

  @@index([parity, direction, sent_at])
}

model telegram_chat {
  chat_id    String   @id
  user_id    String?
  created_at DateTime @default(now())
}

model user_settings {
  id                  Int      @id @default(autoincrement())
  user_id             String   @unique
  balance             Float    @default(500)
  max_leverage        Int      @default(10)
  is_kill_switch_active Boolean @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}
